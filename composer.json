{
    "name": "ledoent/anvil-media-gcs",
    "description": "Keyless WordPress media offload to Google Cloud Storage. Authenticates via Workload Identity / Application Default Credentials \u2014 no service-account keys, no HMAC keys.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "google-cloud-storage",
        "gcs",
        "media",
        "offload",
        "workload-identity",
        "kubernetes",
        "gke"
    ],
    "homepage": "https://github.com/ledoent/anvil-media-gcs",
    "authors": [
        {
            "name": "Ledo Enterprises",
            "homepage": "https://github.com/ledoent"
        }
    ],
    "require": {
        "php": ">=8.1",
        "google/cloud-storage": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "autoload": {
        "psr-4": {
            "Ledoent\\AnvilMediaGcs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ledoent\\AnvilMediaGcs\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs -p src --standard=PHPCompatibility --runtime-set testVersion 8.1-"
    },
    "support": {
        "issues": "https://github.com/ledoent/anvil-media-gcs/issues",
        "source": "https://github.com/ledoent/anvil-media-gcs",
        "docs": "https://github.com/ledoent/anvil-media-gcs#readme"
    }
}
