{
    "name": "ledoent/anvil-media-gcs",
    "description": "Keyless WordPress media offload to Google Cloud Storage. Authenticates via Workload Identity / Application Default Credentials \u2014 no service-account keys, no HMAC keys.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "google-cloud-storage",
        "gcs",
        "media",
        "offload",
        "workload-identity",
        "kubernetes",
        "gke"
    ],
    "homepage": "https://github.com/ledoent/anvil-media-gcs",
    "authors": [
        {
            "name": "Ledo Enterprises",
            "homepage": "https://github.com/ledoent"
        }
    ],
    "require": {
        "php": ">=8.1",
        "google/cloud-storage": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Ledoent\\AnvilMediaGcs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ledoent\\AnvilMediaGcs\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src tests"
    }
}
